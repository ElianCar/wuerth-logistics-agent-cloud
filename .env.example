# Local development defaults.
# Docker Compose overrides these values for the app container.
GEMINI_API_KEY=<your-gemini-api-key>
LLM_PROVIDER=gemini
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite-preview
GEMINI_BACKUP_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024
MAX_PRIMARY_ATTEMPTS=2

# Data scenario for the local prototype.
# Supported local values:
# - demo
# - wuerth_local
# Databricks remains optional/legacy and requires its own credentials.
DATA_SCENARIO=demo

# Backend selected by the active scenario. Local scenarios use PostgreSQL.
SQL_BACKEND=postgres

# Optional Databricks backend configuration for the legacy Würth Databricks scenario.
# Do not commit real hostnames, HTTP paths, tokens, client IDs, or client secrets.
DATABRICKS_AUTH_TYPE=oauth
DATABRICKS_SERVER_HOSTNAME=<your-databricks-server-hostname>
DATABRICKS_HTTP_PATH=<your-sql-warehouse-http-path>
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default
DATABRICKS_ALLOWED_TABLES=workspace.default.datenabzug_projekt_tum_invoices,workspace.default.datenabzug_projekt_tum_shipments

# Optional PAT mode only. PATs are disabled in the current organization.
DATABRICKS_ACCESS_TOKEN=
DATABRICKS_TOKEN=

# Future OAuth machine-to-machine service principal mode.
DATABRICKS_HOST=<your-databricks-workspace-url>
DATABRICKS_CLIENT_ID=<your-service-principal-client-id>
DATABRICKS_CLIENT_SECRET=<your-service-principal-client-secret>

# PostgreSQL local scenarios. Docker Compose overrides host/password for containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Optional local Ollama configuration when LLM_PROVIDER=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
PRIMARY_MODEL=llama3.2:3b
FALLBACK_MODEL=qwen2.5-coder:7b

# Docker Compose app container values are:
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD=postgres
# OLLAMA_HOST=http://host.docker.internal:11434
