# Local development defaults.
# Docker Compose overrides these values for the app container.
GEMINI_API_KEY=<your-gemini-api-key>
LLM_PROVIDER=gemini
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite-preview
GEMINI_BACKUP_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Optional local Ollama configuration when LLM_PROVIDER=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
PRIMARY_MODEL=llama3.2:3b
FALLBACK_MODEL=qwen2.5-coder:7b
MAX_PRIMARY_ATTEMPTS=2

# Docker Compose app container values are:
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD=postgres
# OLLAMA_HOST=http://host.docker.internal:11434
